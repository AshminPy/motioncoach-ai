# Template for infra/sparkyfitness/.env — copy this file to .env and fill in
# real generated values. Never commit the real .env (it is gitignored).
#
# Generate strong secrets with:
#   openssl rand -hex 24      # DB passwords
#   openssl rand -hex 32      # SPARKY_FITNESS_API_ENCRYPTION_KEY (must be 64 hex chars or 44 base64 chars)
#   openssl rand -base64 32   # BETTER_AUTH_SECRET (must be valid base64 — server does Buffer.from(secret, 'base64'))

# --- Database ---
SPARKY_FITNESS_DB_NAME=motioncoach_sparkyfitness
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_24
SPARKY_FITNESS_APP_DB_USER=sparkyapp
SPARKY_FITNESS_APP_DB_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_24

# --- Frontend / networking ---
# Change SPARKY_FITNESS_FRONTEND_PORT if 3004 is already in use on this Mac
# (check first: lsof -i :3004).
SPARKY_FITNESS_FRONTEND_URL=http://localhost:3004
SPARKY_FITNESS_FRONTEND_PORT=3004

# --- Essential app security ---
SPARKY_FITNESS_API_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# --- Server runtime & admin ---
SPARKY_FITNESS_LOG_LEVEL=INFO
SPARKY_FITNESS_DISABLE_SIGNUP=false
# Optional: promote an email to admin on startup, e.g. your own signup email.
# SPARKY_FITNESS_ADMIN_EMAIL=
NODE_ENV=production
TZ=Etc/UTC

# --- Volume paths (relative to this .env's directory) ---
# Left at compose defaults (./postgresql, ./uploads, ./backup) so this stack's
# data stays inside infra/sparkyfitness/ and never collides with any other
# Docker stack on this machine. Uncomment to override:
# DB_PATH=./postgresql
# SERVER_UPLOADS_PATH=./uploads
# SERVER_BACKUP_PATH=./backup
